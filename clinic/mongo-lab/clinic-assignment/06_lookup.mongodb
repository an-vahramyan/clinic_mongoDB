// ============================================================
// L7. BONUS — FIND INVALID DOCTOR REFERENCES
// This section creates two deliberately incorrect appointments,
// finds them with $lookup, and deletes them afterwards.
// ============================================================

// ------------------------------------------------------------
// L7.0 CLEAN UP LEFTOVER BONUS DOCUMENTS
// Makes this bonus section safe to run again.
// ------------------------------------------------------------

db.appointments.deleteMany({
  reason: {
    $in: [
      "L7a - missing doctor reference",
      "L7b - doctor points to patient",
    ],
  },
});

// Result:
// deletedCount: 0 on the first run.
// Any leftover bonus documents are removed on later runs.

// ------------------------------------------------------------
// L7.1 GET A PATIENT ID
// This ID will be incorrectly used as a doctorId in L7b.
// ------------------------------------------------------------

var l7Patient = db.users.findOne(
  { email: "ana.costa@example.com" },
  { _id: 1 }
);

var l7PatientId = l7Patient._id;

// ------------------------------------------------------------
// L7.2 INSERT TWO INVALID APPOINTMENTS
// Both documents satisfy the BSON type requirements,
// but their doctor references are logically incorrect.
// ------------------------------------------------------------

var l7MissingDoctorId = new ObjectId();

var l7InsertResult = db.appointments.insertMany([
  {
    doctorId: l7MissingDoctorId,
    patientId: l7PatientId,
    start: new Date("2025-05-01T09:00:00Z"),
    durationMin: 15,
    reason: "L7a - missing doctor reference",
    status: "scheduled",
    fee: 0,
  },
  {
    doctorId: l7PatientId,
    patientId: l7PatientId,
    start: new Date("2025-05-01T10:00:00Z"),
    durationMin: 15,
    reason: "L7b - doctor points to patient",
    status: "scheduled",
    fee: 0,
  },
]);

// Result:
// 2 appointments inserted.

// ------------------------------------------------------------
// L7a. FIND APPOINTMENT WITH A NON-EXISTENT DOCTOR
// The doctorId does not match any user in the users collection.
